{
  "name": "cowworld",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  // Static client. Requests that match no file (like /ws) fall through to the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }]
}
